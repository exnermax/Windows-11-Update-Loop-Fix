@echo off
REM ==============================================================
REM  NAME:       Windows 11 Update Loop Fix
REM  VERSION:    2.0
REM  BUILD DATE: 20 September 2026
REM  AUTHOR:     Max Exner
REM  LICENSE:    MIT
REM
REM  Arguments:
REM    /y          Unattended: no prompts, no restart
REM    /elevated   Internal: script was already relaunched as admin
REM
REM  All output is plain ASCII on purpose, so the script does not
REM  need to touch the console codepage.
REM ==============================================================

setlocal EnableExtensions EnableDelayedExpansion
title Windows 11 Update Loop Fix 2.0

set "LOGDIR=%ProgramData%\Win11UpdateFix"
set "LOG=%LOGDIR%\Win11UpdateFix.log"
set "STATE=%LOGDIR%\services.state"
set "ERRORS=0"
set "REBOOT=0"
set "ROLLEDBACK="

REM --- Unattended switch ----------------------------------------
set "UNATTENDED="
echo %* | findstr /i /c:"/y" >nul 2>&1 && set "UNATTENDED=1"

REM ==============================================================
REM  1. Check for administrator rights, request them if missing
REM ==============================================================
fltmc >nul 2>&1
if %errorlevel% equ 0 goto :have_admin
net session >nul 2>&1
if %errorlevel% equ 0 goto :have_admin

if /i "%~1"=="/elevated" goto :no_admin
set "PASSARGS=/elevated"
if defined UNATTENDED set "PASSARGS=/elevated /y"
echo.
echo Requesting administrator rights - click Yes on the User Account Control prompt.
powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -ArgumentList '%PASSARGS%' -Verb RunAs" >nul 2>&1
if %errorlevel% neq 0 goto :no_admin
exit /b 0

:no_admin
echo.
echo   ERROR: This script requires administrator rights.
echo   Right-click the file and choose "Run as administrator".
echo.
if not defined UNATTENDED pause
exit /b 1

:have_admin
if not exist "%LOGDIR%" md "%LOGDIR%" >nul 2>&1
>"%LOG%" echo ===== Windows 11 Update Loop Fix 2.0 =====
>>"%LOG%" echo Start: %DATE% %TIME%
>>"%LOG%" echo Computer: %COMPUTERNAME%  User: %USERNAME%

REM --- Detect an aborted previous run and roll it back ----------
if exist "%STATE%" (
    echo.
    echo   NOTE: A previous run did not finish.
    echo   Restoring the service start types first.
    set "ROLLEDBACK=1"
    call :restore_state
)

REM ==============================================================
REM  2. Intro and pre-flight diagnostics
REM ==============================================================
cls
echo.
echo  ============================================================
echo   Windows 11 Update Loop Fix  -  Version 2.0
echo  ============================================================
echo.
echo   This script resets the Windows Update components:
echo     - stuck download jobs are discarded
echo     - SoftwareDistribution and catroot2 are renamed,
echo       not deleted - so the change can be undone
echo     - proxy and clock settings are cleaned up
echo     - DISM repairs the component store, SFC the system files
echo.
echo   Log file: %LOG%
echo.

call :head "Pre-flight diagnostics"

REM --- Windows version ------------------------------------------
set "BUILD=0"
for /f "tokens=3" %%v in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v CurrentBuildNumber 2^>nul ^| findstr /i "REG_SZ"') do set "BUILD=%%v"
REM  ProductName still reports "Windows 10" on Windows 11, so the
REM  version is derived from the build number instead.
set "OSNAME=Windows 10"
if %BUILD% GEQ 22000 set "OSNAME=Windows 11"
set "EDITION="
for /f "tokens=3" %%v in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v EditionID 2^>nul ^| findstr /i "REG_SZ"') do set "EDITION=%%v"
set "DISPVER="
for /f "tokens=3" %%v in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v DisplayVersion 2^>nul ^| findstr /i "REG_SZ"') do set "DISPVER=%%v"
call :say "  System:       %OSNAME% %EDITION% %DISPVER% - build %BUILD%"
if %BUILD% LSS 22000 call :warn "This PC is running Windows 10. The script works here too, but it was written for Windows 11."

REM --- Free disk space ------------------------------------------
REM  Note: 0 is a valid reading on a nearly full drive, so an
REM  unset variable and a zero must be told apart here.
set "FREEGB="
for /f "delims=" %%v in ('powershell -NoProfile -Command "[math]::Floor((Get-PSDrive -Name ($env:SystemDrive.Substring(0,1))).Free/1GB)" 2^>nul') do set "FREEGB=%%v"
if not defined FREEGB goto :space_unknown
echo %FREEGB%| findstr /r "^[0-9][0-9]*$" >nul 2>&1
if errorlevel 1 goto :space_unknown
call :say "  Free space:   %FREEGB% GB on %SystemDrive%"
if %FREEGB% LSS 20 call :warn "Less than 20 GB free. Windows 11 feature updates usually need 20-30 GB and will fail if there is less. Free up space before trying again."
goto :space_done
:space_unknown
call :say "  Free space:   unknown"
:space_done

REM --- WSUS / Windows Update policies ---------------------------
reg query "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate" /v WUServer >nul 2>&1
if %errorlevel% equ 0 call :warn "A WSUS server is configured by Group Policy. If this PC is not on a company network, that is the most likely cause of the update loop."

REM  Check the VALUE, not just its presence - NoAutoUpdate=0 is a
REM  common leftover and means updates are switched ON.
for /f "tokens=3" %%v in ('reg query "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU" /v NoAutoUpdate 2^>nul ^| findstr /i "REG_DWORD"') do if /i "%%v"=="0x1" call :warn "A Group Policy disables automatic updates. Open gpedit.msc and look under Computer Configuration - Administrative Templates - Windows Components - Windows Update."

REM --- System clock ---------------------------------------------
call :say "  System time:  %DATE% %TIME%"
call :say "  An incorrect clock is a common cause of update failures - the script resets it later."
echo.

if defined UNATTENDED goto :start_work
choice /c YN /n /m "  Reset the Windows Update components now? [Y/N] "
if errorlevel 2 goto :abort
echo.

:start_work

REM ==============================================================
REM  3. Discard stuck BITS jobs - BITS is still running here
REM ==============================================================
call :head "Discarding stuck download jobs"
bitsadmin /reset /allusers >>"%LOG%" 2>&1
if %errorlevel% equ 0 goto :bits_ok
powershell -NoProfile -Command "Get-BitsTransfer -AllUsers -ErrorAction SilentlyContinue | Remove-BitsTransfer -ErrorAction Stop" >>"%LOG%" 2>&1
if %errorlevel% equ 0 goto :bits_ok
call :say "  No download jobs could be read - continuing."
goto :bits_done
:bits_ok
call :say "  Stuck download jobs discarded."
:bits_done

REM ==============================================================
REM  4. Save start types and disable the services temporarily
REM ==============================================================
call :head "Stopping update services"
call :save_start usosvc
call :save_start dosvc
call :save_start wuauserv
call :save_start bits

for %%s in (usosvc dosvc wuauserv bits) do sc config %%s start= disabled >>"%LOG%" 2>&1

call :svc_stop usosvc
call :svc_stop dosvc
call :svc_stop wuauserv
call :svc_stop bits
call :svc_stop appidsvc
call :svc_stop cryptsvc

REM ==============================================================
REM  5. Reset the update caches
REM ==============================================================
call :head "Resetting update caches"

call :reset_folder "%windir%\SoftwareDistribution" "SoftwareDistribution"
call :reset_folder "%windir%\System32\catroot2" "catroot2"

set "DLDIR=%ProgramData%\Microsoft\Network\Downloader"
if not exist "%DLDIR%" goto :dl_done
del /f /q "%DLDIR%\qmgr*.dat" >>"%LOG%" 2>&1
del /f /q "%DLDIR%\qmgr*.db" >>"%LOG%" 2>&1
call :say "  BITS database in the Downloader folder deleted."
:dl_done

powershell -NoProfile -Command "if (Get-Command Delete-DeliveryOptimizationCache -ErrorAction SilentlyContinue) { Delete-DeliveryOptimizationCache -Force -ErrorAction Stop } else { exit 1 }" >>"%LOG%" 2>&1
if %errorlevel% equ 0 goto :do_ok
call :say "  Delivery Optimization cache not cleared - skipped."
goto :do_done
:do_ok
call :say "  Delivery Optimization cache cleared."
:do_done

REM ==============================================================
REM  6. Clean up network settings used by Windows Update
REM ==============================================================
call :head "Cleaning up network settings"
netsh winhttp reset proxy >>"%LOG%" 2>&1
netsh winhttp reset tracing >>"%LOG%" 2>&1
call :say "  WinHTTP proxy reset."

REM ==============================================================
REM  7. Re-enable and restart the services
REM ==============================================================
call :head "Restarting services"
call :restore_start bits
call :restore_start wuauserv
call :restore_start dosvc
call :restore_start usosvc

call :svc_start cryptsvc
call :svc_start_quiet appidsvc
call :svc_start bits
call :svc_start wuauserv

del /f /q "%STATE%" >nul 2>&1

REM ==============================================================
REM  8. Synchronize the system clock
REM ==============================================================
call :head "Synchronizing the system clock"
sc config w32time start= demand >>"%LOG%" 2>&1
net start w32time >>"%LOG%" 2>&1
w32tm /resync /force >>"%LOG%" 2>&1
if %errorlevel% equ 0 goto :time_ok
call :warn "Time sync failed. Open Settings, then Time and language, and check the date, time and time zone yourself."
goto :time_done
:time_ok
call :say "  Clock synced with the time server: %DATE% %TIME%"
:time_done

REM ==============================================================
REM  9. Repair the component store - DISM before SFC
REM ==============================================================
call :head "Checking and repairing the component store"
echo   This step can take 10-30 minutes. Please do not cancel it.
echo.
Dism.exe /Online /Cleanup-Image /RestoreHealth
set "RC=%errorlevel%"
>>"%LOG%" echo [DISM RestoreHealth] exit code %RC%
if "%RC%"=="0" call :say "  DISM: the component store is healthy."
if "%RC%"=="3010" set "REBOOT=1"
if "%RC%"=="3010" call :say "  DISM: repair succeeded - a restart is required."
if not "%RC%"=="0" if not "%RC%"=="3010" call :warn "DISM returned exit code %RC%. Details in %windir%\Logs\DISM\dism.log"

echo.
Dism.exe /Online /Cleanup-Image /StartComponentCleanup >>"%LOG%" 2>&1
set "RC=%errorlevel%"
>>"%LOG%" echo [DISM StartComponentCleanup] exit code %RC%
if "%RC%"=="0" goto :cleanup_ok
call :say "  Component store cleanup skipped - DISM exit code %RC%."
goto :cleanup_done
:cleanup_ok
call :say "  Superseded update files removed from the component store."
:cleanup_done

REM ==============================================================
REM  10. Check system files
REM ==============================================================
call :head "Checking system files"
echo   This step usually takes 5 to 15 minutes. Please do not cancel it either.
echo.
sfc /scannow
set "RC=%errorlevel%"
>>"%LOG%" echo [SFC scannow] exit code %RC%
if "%RC%"=="0" goto :sfc_ok
call :warn "SFC returned exit code %RC%. Details in %windir%\Logs\CBS\CBS.log"
goto :sfc_done
:sfc_ok
REM  Exit code 0 covers both "nothing wrong" and "repaired it",
REM  so the message must not claim either one.
call :say "  SFC: system file check completed - details in CBS.log"
:sfc_done

REM ==============================================================
REM  11. Trigger an update scan
REM ==============================================================
call :head "Triggering an update scan"
powershell -NoProfile -Command "(New-Object -ComObject Microsoft.Update.AutoUpdate).DetectNow()" >>"%LOG%" 2>&1
if %errorlevel% equ 0 goto :scan_ok
"%windir%\System32\UsoClient.exe" StartScan >>"%LOG%" 2>&1
if %errorlevel% equ 0 goto :scan_ok
call :say "  Could not start a scan - open Windows Update and check manually."
goto :scan_done
:scan_ok
call :say "  Windows is now scanning for updates in the background."
:scan_done

REM ==============================================================
REM  12. Summary
REM ==============================================================
echo.
echo  ============================================================
if "%ERRORS%"=="0" echo   DONE - all steps completed with no warnings.
if not "%ERRORS%"=="0" echo   DONE - %ERRORS% warning^(s^); see the log file.
echo  ============================================================
echo.
echo   Log file:   %LOG%
echo.

set "HAVEBAK="
if exist "%windir%\SoftwareDistribution.bak" set "HAVEBAK=1"
if exist "%windir%\System32\catroot2.bak" set "HAVEBAK=1"
if not defined HAVEBAK goto :nobak
echo   Rollback:
if exist "%windir%\SoftwareDistribution.bak" echo               %windir%\SoftwareDistribution.bak
if exist "%windir%\System32\catroot2.bak" echo               %windir%\System32\catroot2.bak
echo               These folders can be deleted once Windows
echo               Update works again.
echo.
:nobak

if "%REBOOT%"=="1" echo   NOTE: DISM needs a restart to finish its repair.
echo   IMPORTANT: Please restart the PC so that all changes
echo              take effect.
echo.
>>"%LOG%" echo End: %DATE% %TIME% - warnings: %ERRORS%

if defined UNATTENDED goto :done
choice /c YN /n /m "  Restart the PC now? [Y/N] "
if errorlevel 2 goto :done
shutdown /r /t 30 /c "Restarting after Windows Update repair"
echo.
echo   The PC will restart in 30 seconds.
echo   To cancel:  shutdown /a
echo.

:done
if not defined UNATTENDED pause
endlocal
exit /b 0

:abort
echo.
echo   Aborted - the Windows Update reset was not started.
if defined ROLLEDBACK echo   The service start types from the previous run were restored.
del /f /q "%STATE%" >nul 2>&1
if not defined UNATTENDED pause
endlocal
exit /b 0


REM ==============================================================
REM  Helper routines
REM ==============================================================

:say
echo %~1
>>"%LOG%" echo [%TIME%] %~1
goto :eof

:head
echo.
echo  --- %~1 ---
echo.
>>"%LOG%" echo.
>>"%LOG%" echo [%TIME%] === %~1 ===
goto :eof

:warn
echo   WARNING: %~1
>>"%LOG%" echo [%TIME%] WARNING: %~1
set /a ERRORS+=1
goto :eof

:svc_exists
sc query "%~1" >nul 2>&1
exit /b %errorlevel%

REM  sc.exe localizes its status text, so check the English and
REM  the German wording. This is about the Windows UI language,
REM  not about the language of this script.
:is_stopped
sc query "%~1" 2>nul | findstr /i /c:"STOPPED" /c:"BEENDET" >nul 2>&1
exit /b %errorlevel%

:svc_stop
set "_svc=%~1"
call :svc_exists %_svc%
if %errorlevel% neq 0 goto :eof
call :is_stopped %_svc%
if %errorlevel% equ 0 goto :svc_stop_done
net stop %_svc% /y >>"%LOG%" 2>&1
timeout /t 2 /nobreak >nul 2>&1
call :is_stopped %_svc%
if %errorlevel% equ 0 goto :svc_stop_done
call :warn "Service %_svc% could not be stopped. Please run the script again in Safe Mode."
goto :eof
:svc_stop_done
call :say "  Service %_svc% stopped."
goto :eof

:svc_start
set "_svc=%~1"
call :svc_exists %_svc%
if %errorlevel% neq 0 goto :eof
net start %_svc% >>"%LOG%" 2>&1
call :is_stopped %_svc%
if %errorlevel% neq 0 goto :svc_start_ok
call :warn "Service %_svc% is not running yet. It usually starts automatically after the next restart."
goto :eof
:svc_start_ok
call :say "  Service %_svc% started."
goto :eof

REM --- Start without warning: for trigger-started services ------
:svc_start_quiet
set "_svc=%~1"
call :svc_exists %_svc%
if %errorlevel% neq 0 goto :eof
net start %_svc% >>"%LOG%" 2>&1
call :say "  Service %_svc% start requested - it starts on demand."
goto :eof

REM --- Read the start type from the registry: language neutral --
:save_start
set "_svc=%~1"
call :svc_exists %_svc%
if %errorlevel% neq 0 goto :eof
set "_raw="
set "_delay="
for /f "tokens=3" %%v in ('reg query "HKLM\SYSTEM\CurrentControlSet\Services\%_svc%" /v Start 2^>nul ^| findstr /i "REG_DWORD"') do set "_raw=%%v"
for /f "tokens=3" %%v in ('reg query "HKLM\SYSTEM\CurrentControlSet\Services\%_svc%" /v DelayedAutostart 2^>nul ^| findstr /i "REG_DWORD"') do set "_delay=%%v"
set "_mode="
if /i "%_raw%"=="0x2" set "_mode=auto"
if /i "%_raw%"=="0x3" set "_mode=demand"
if /i "%_raw%"=="0x4" set "_mode=demand"
if /i "%_raw%"=="0x2" if /i "%_delay%"=="0x1" set "_mode=delayed-auto"
if not defined _mode set "_mode=demand"
>>"%STATE%" echo %_svc%=%_mode%
set "START_%_svc%=%_mode%"
>>"%LOG%" echo [%TIME%] Start type saved: %_svc% = %_mode%
goto :eof

:restore_start
set "_svc=%~1"
call :svc_exists %_svc%
if %errorlevel% neq 0 goto :eof
set "_mode=!START_%_svc%!"
if not defined _mode goto :eof
sc config %_svc% start= !_mode! >>"%LOG%" 2>&1
>>"%LOG%" echo [%TIME%] Start type restored: %_svc% = !_mode!
goto :eof

:restore_state
for /f "usebackq tokens=1,2 delims==" %%a in ("%STATE%") do sc config %%a start= %%b >>"%LOG%" 2>&1
del /f /q "%STATE%" >nul 2>&1
goto :eof

REM --- Rename instead of delete, so the change can be undone ----
:reset_folder
set "_path=%~1"
set "_name=%~2"
if exist "%_path%" goto :rf_go
call :say "  %_name% does not exist - skipped."
goto :eof
:rf_go
attrib -h -r -s "%_path%" >nul 2>&1
attrib -h -r -s "%_path%\*" /s /d >nul 2>&1
if exist "%_path%.bak" rd /s /q "%_path%.bak" >nul 2>&1
ren "%_path%" "%_name%.bak" >>"%LOG%" 2>&1
if exist "%_path%" goto :rf_fallback
call :say "  %_name% renamed to %_name%.bak - Windows will recreate it."
goto :eof
:rf_fallback
rd /s /q "%_path%" >>"%LOG%" 2>&1
if exist "%_path%" goto :rf_failed
call :say "  %_name% deleted."
goto :eof
:rf_failed
call :warn "%_name% is locked and could not be reset. Please run the script again in Safe Mode."
goto :eof
